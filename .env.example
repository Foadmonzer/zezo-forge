# Copy to .env and fill only when ready to activate integrations.
# Keep .env private; never commit real credentials.
ZEZO_PUBLIC_URL=http://localhost:4173
# Optional for local JSON preview. Set a private PostgreSQL URL to use normalized entity tables.
# Never point this file at production data during tests.
DATABASE_URL=
ZEZO_DATABASE_POOL_SIZE=8
# Owner signup is permanently closed in public UI/API. The first Owner is
# provisioned only through the private interactive CLI against PostgreSQL.
# Configure only if the host proxy overwrites forwarded client IP headers.
# Trust X-Forwarded-For only when the deployment is behind a proxy that overwrites it.
ZEZO_TRUST_PROXY=0
ZEZO_NOTIFICATION_EMAIL=
# Leave false in local review/Staging; enable only after the owner approves real delivery.
ZEZO_ENABLE_EMAIL_DELIVERY=false
ZEZO_FROM_EMAIL=
RESEND_API_KEY=
ZEZO_CUSTOMER_SUPPORT_WHATSAPP=
ZEZO_ORDERS_WHATSAPP=
# Backward-compatible fallback for older local builds; set the two numbers above instead.
ZEZO_WHATSAPP_NUMBER=
OPENAI_API_KEY=
OPENAI_MODEL=
# 32-byte base64 key for AES-256-GCM database backups. Store in a secrets manager,
# never in source control or on the same disk as production backups.
ZEZO_BACKUP_ENCRYPTION_KEY=
# S3-compatible encrypted backup destination (set only in Railway's secret store).
ZEZO_BACKUP_S3_ENDPOINT=
ZEZO_BACKUP_S3_BUCKET=
ZEZO_BACKUP_S3_ACCESS_KEY_ID=
ZEZO_BACKUP_S3_SECRET_ACCESS_KEY=
ZEZO_BACKUP_S3_REGION=auto
ZEZO_BACKUP_S3_URL_STYLE=virtual
