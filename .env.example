# Copy to .env and fill only when ready to activate integrations.
# Keep .env private; never commit real credentials.
ZEZO_PUBLIC_URL=http://localhost:4173
# Optional for local JSON preview. Set a private PostgreSQL URL to use normalized entity tables.
# Never point this file at production data during tests.
DATABASE_URL=
ZEZO_DATABASE_POOL_SIZE=8
# Trust X-Forwarded-For only when the deployment is behind a proxy that overwrites it.
ZEZO_TRUST_PROXY=0
ZEZO_NOTIFICATION_EMAIL=
ZEZO_FROM_EMAIL=
RESEND_API_KEY=
ZEZO_CUSTOMER_SUPPORT_WHATSAPP=
ZEZO_ORDERS_WHATSAPP=
# Backward-compatible fallback for older local builds; set the two numbers above instead.
ZEZO_WHATSAPP_NUMBER=
OPENAI_API_KEY=
OPENAI_MODEL=
