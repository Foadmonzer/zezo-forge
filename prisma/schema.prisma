generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// JSON payloads preserve full legacy records during staged migration; indexed columns
// and entity tables make ownership, workflow state and financial integrity queryable.
model UserAccount {
  id           String   @id
  email        String?  @unique
  username     String?  @unique
  role         String
  active       Boolean  @default(true)
  fullName     String?
  passwordHash String?
  data         Json     @db.JsonB
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerRequests ProjectRequest[] @relation("RequestCustomer")
  referredRequests ProjectRequest[] @relation("RequestReferrer")
  customerChats    Conversation[]   @relation("ConversationCustomer")
  assignedChats    Conversation[]   @relation("ConversationAssignee")
  sessions         AuthSession[]
  withdrawals      WithdrawalRequest[] @relation("WithdrawalOwner")
  reviewedWithdrawals WithdrawalRequest[] @relation("WithdrawalReviewer")

  @@index([role, active])
  @@map("user_accounts")
}

model ProjectRequest {
  id           String   @id
  customerId   String?
  referrerId   String?
  developerId  String?
  status       String?
  projectStage String?
  templateId   String?
  agreedAmount Decimal? @db.Decimal(12, 2)
  currency     String   @default("ILS")
  data         Json     @db.JsonB
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     UserAccount? @relation("RequestCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  referrer     UserAccount? @relation("RequestReferrer", fields: [referrerId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([referrerId, status])
  @@index([developerId, projectStage])
  @@index([templateId])
  @@map("project_requests")
}

model Project {
  id          String   @id
  requestId   String?  @unique
  developerId String?
  stage       String
  dueAt       DateTime?
  data        Json     @db.JsonB
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([developerId, stage])
  @@map("projects")
}

model ProjectAssignment {
  id                 String   @id
  projectId          String
  developerId        String
  state              String
  commissionPercent  Decimal  @default(25) @db.Decimal(5, 2)
  expectedCommission Decimal? @db.Decimal(12, 2)
  data               Json     @db.JsonB
  assignedAt         DateTime @default(now())
  respondedAt        DateTime?

  @@index([developerId, state])
  @@index([projectId, state])
  @@map("project_assignments")
}

model Conversation {
  id           String   @id
  customerId   String?
  assignedToId String?
  status       String
  templateId   String?
  source       String?
  data         Json     @db.JsonB
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     UserAccount? @relation("ConversationCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo   UserAccount? @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     ConversationMessage[]
  quotes       Quote[]

  @@index([assignedToId, status, updatedAt])
  @@index([customerId, updatedAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id
  conversationId String
  senderId       String?
  body           String
  attachmentId   String?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model Quote {
  id             String   @id
  conversationId String
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("ILS")
  state          String
  data           Json     @db.JsonB
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, state])
  @@map("quotes")
}

model Payment {
  id             String   @id
  requestId      String
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("ILS")
  status         String
  idempotencyKey String?  @unique
  data           Json     @db.JsonB
  createdAt      DateTime @default(now())

  @@index([requestId, status])
  @@map("payments")
}

model Commission {
  id              String   @id
  userId          String
  requestId       String
  kind            String
  ratePercent     Decimal  @db.Decimal(5, 2)
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("ILS")
  status          String
  sourcePaymentId String?
  data            Json     @db.JsonB
  createdAt       DateTime @default(now())

  @@unique([userId, requestId, kind])
  @@index([userId, status])
  @@map("commissions")
}

model WalletTransaction {
  id             String   @id
  userId         String
  requestId      String?
  type           String
  status         String
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("ILS")
  idempotencyKey String?  @unique
  data           Json     @db.JsonB
  createdAt      DateTime @default(now())

  @@index([userId, status, createdAt])
  @@map("wallet_transactions")
}

model FinanceLedgerEntry {
  id             String   @id
  type           String
  status         String
  requestId      String?
  employeeId     String?
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("ILS")
  idempotencyKey String?  @unique
  data           Json     @db.JsonB
  createdAt      DateTime @default(now())

  @@index([type, status, createdAt])
  @@index([employeeId, createdAt])
  @@map("finance_ledger_entries")
}

model ExpenseRecord {
  id         String   @id
  category   String
  status     String
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("ILS")
  recordedBy String
  data       Json     @db.JsonB
  createdAt  DateTime @default(now())

  @@index([category, createdAt])
  @@index([status, createdAt])
  @@map("expense_records")
}

model WithdrawalRequest {
  id         String   @id
  userId     String
  amount     Decimal  @db.Decimal(12, 2)
  status     String
  reviewedBy String?
  data       Json     @db.JsonB
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       UserAccount @relation("WithdrawalOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewer   UserAccount? @relation("WithdrawalReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

model RankRequest {
  id               String   @id
  userId           String
  fromRank         String
  requestedRank    String
  salesCount       Int
  commissionPercent Decimal? @db.Decimal(5, 2)
  state            String
  reviewedBy       String?
  data             Json     @db.JsonB
  createdAt        DateTime @default(now())
  reviewedAt       DateTime?

  @@index([userId, state])
  @@index([state, createdAt])
  @@map("rank_requests")
}

model EmployeeInvitation {
  id          String   @id
  email       String?
  role        String
  status      String
  expiresAt   DateTime
  invitedById String
  data        Json     @db.JsonB
  createdAt   DateTime @default(now())

  @@index([email, status])
  @@index([invitedById, createdAt])
  @@map("employee_invitations")
}

model ReferralLink {
  id        String   @id
  userId    String
  code      String   @unique
  month     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  data      Json     @db.JsonB

  @@index([userId, month])
  @@map("referral_links")
}

model ReferralEvent {
  id          String   @id
  userId      String?
  code        String?
  eventType   String
  visitorHash String?
  resourceId  String?
  requestId   String?
  createdAt   DateTime @default(now())
  data        Json     @db.JsonB

  @@index([userId, eventType, createdAt])
  @@index([requestId, eventType])
  @@map("referral_events")
}

model ReferralAttribution {
  id        String   @id
  userId    String
  requestId String?
  code      String
  createdAt DateTime @default(now())
  data      Json     @db.JsonB

  @@index([userId, createdAt])
  @@index([requestId])
  @@map("referral_attributions")
}

model CRMRecord {
  id        String   @id
  status    String?
  source    String?
  data      Json     @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@map("crm_records")
}

model SystemNotification {
  id        String   @id
  userId    String
  type      String?
  readAt    DateTime?
  data      Json     @db.JsonB
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@map("system_notifications")
}

model AuditEntry {
  id        String   @id
  actorId   String?
  action    String
  targetId  String?
  data      Json     @db.JsonB
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@map("audit_entries")
}

model TemplatePrice {
  templateId String   @id
  price      Decimal  @db.Decimal(12, 2)
  active     Boolean  @default(true)
  currency   String   @default("ILS")
  data       Json     @db.JsonB
  updatedAt  DateTime @updatedAt

  @@map("template_prices")
}

model AppSetting {
  key       String   @id
  value     Json     @db.JsonB
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model AuthSession {
  id        String   @id
  userId    String
  expiresAt DateTime
  data      Json     @db.JsonB
  createdAt DateTime @default(now())
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model StoredAttachment {
  id          String   @id
  ownerId     String?
  fileName    String
  contentType String
  sizeBytes   Int
  content     Bytes
  createdAt   DateTime @default(now())

  @@index([ownerId, createdAt])
  @@map("stored_attachments")
}

model OutboxMessage {
  id        String   @id
  recipient String?
  state     String
  attempts  Int      @default(0)
  data      Json     @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, createdAt])
  @@map("outbox_messages")
}

model MarketingCampaign {
  id        String   @id
  state     String?
  data      Json     @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, updatedAt])
  @@map("marketing_campaigns")
}

// Short-lived compatibility bridge only; the staged migration will remove this table
// after normalized records are populated and the import parity checks pass.
model ApplicationState {
  id        String   @id
  revision  BigInt   @default(0)
  data      Json     @db.JsonB
  updatedAt DateTime @updatedAt

  @@map("application_state_compat")
}
